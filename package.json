{
  "name": "fpl-basket-rebuild",
  "private": true,
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fpl-basket/contracts build && pnpm --parallel --filter @fpl-basket/api --filter @fpl-basket/web dev",
    "build": "pnpm --filter @fpl-basket/contracts build && pnpm --filter @fpl-basket/web build && pnpm --filter @fpl-basket/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @fpl-basket/contracts test && pnpm --filter @fpl-basket/api test && pnpm --filter @fpl-basket/web test",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @fpl-basket/api start"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
